---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "El sabor del cacao: El Néctar De Los Dioses" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Una experiencia sensorial que trasciende el tiempo. Únete a la presentación de nuestro proyecto artesanal." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
		<meta name="generator" content={Astro.generator} />
		
		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Una experiencia sensorial que trasciende el tiempo. Únete a la presentación de nuestro proyecto artesanal." />
		<meta property="og:image" content="/cacao_bg.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content="Una experiencia sensorial que trasciende el tiempo. Únete a la presentación de nuestro proyecto artesanal." />
		<meta property="twitter:image" content="/cacao_bg.png" />

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
	}
</style>
