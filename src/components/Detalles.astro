<!-- Client-side Javascript for the countdown timer -->
<script>
  // Target date: June 19, 2026 at 09:00:00 AM (local time timezone Tabasco GMT-6)
  const targetDate = new Date("2026-06-19T09:00:00-06:00").getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const distance = targetDate - now;

    const daysEl = document.getElementById("days-val");
    const hoursEl = document.getElementById("hours-val");
    const minutesEl = document.getElementById("minutes-val");
    const secondsEl = document.getElementById("seconds-val");

    if (!daysEl || !hoursEl || !minutesEl || !secondsEl) return;

    if (distance < 0) {
      daysEl.innerText = "00";
      hoursEl.innerText = "00";
      minutesEl.innerText = "00";
      secondsEl.innerText = "00";
      return;
    }

    // Time calculations
    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
    );
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    // Render with leading zero
    daysEl.innerText = String(days).padStart(2, "0");
    hoursEl.innerText = String(hours).padStart(2, "0");
    minutesEl.innerText = String(minutes).padStart(2, "0");
    secondsEl.innerText = String(seconds).padStart(2, "0");
  }

  // Run immediately and update every second
  updateCountdown();
  setInterval(updateCountdown, 1000);

  // Lógica de Spotlight Secuencial para el cuerpo docente
  let activeIndex = -1;
  let highlightInterval: number | null = null;
  const cards = document.querySelectorAll('.presenter-card');
  const grid = document.querySelector('.presenters-grid');

  function startHighlightSequence() {
    if (highlightInterval) return;
    
    // Mostrar todas las tarjetas inicialmente
    cards.forEach((card) => {
      card.classList.add('visible');
    });

    const rotateHighlight = () => {
      // Quitar destaque de la tarjeta anterior
      if (activeIndex >= 0 && activeIndex < cards.length) {
        cards[activeIndex].classList.remove('highlighted');
      }

      // Avanzar al siguiente docente en bucle
      activeIndex = (activeIndex + 1) % cards.length;

      // Destacar nueva tarjeta
      cards[activeIndex].classList.add('highlighted');
      grid?.classList.add('has-highlighted');
    };

    // Primer disparo inmediato al entrar
    rotateHighlight();
    
    // Rotación tranquila cada 2.5 segundos
    highlightInterval = window.setInterval(rotateHighlight, 2500);
  }

  function stopHighlightSequence() {
    if (highlightInterval) {
      window.clearInterval(highlightInterval);
      highlightInterval = null;
    }
    cards.forEach((card) => {
      card.classList.remove('highlighted');
    });
    grid?.classList.remove('has-highlighted');
    activeIndex = -1;
  }

  // Configuración del Intersection Observer para activar/desactivar al hacer scroll
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1 // Dispara cuando el 10% del bloque es visible
  };

  const presentersObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        startHighlightSequence();
      } else {
        stopHighlightSequence();
      }
    });
  }, observerOptions);

  if (grid) {
    presentersObserver.observe(grid);
  }
</script>

<style>
  /* Base section - Full screen height vertically centered */
  .detalles-section {
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: var(--color-background);
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Paper texture pattern for countdown card */
  .paper-texture {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      var(--color-outline-variant, #d5c2bf) 0.6px,
      transparent 0.6px
    );
    background-size: 24px 24px;
    opacity: 0.15;
    pointer-events: none;
    z-index: 1;
  }

  /* Container */
  .detalles-container {
    width: 100%;
    max-width: var(--spacing-container-max, 1200px);
    margin: 0 auto;
    padding: 64px var(--margin-desktop, 64px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }

  /* Banner de Video Cinematográfico Full-Width */
  .event-video-banner {
    width: 100%;
    height: 50vh;
    min-height: 280px;
    max-height: 500px;
    overflow: hidden;
    position: relative;
    background-color: #000000;
    border-bottom: 1px solid rgba(35, 8, 4, 0.08);
  }

  .event-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Ocultar botones de audio y volumen nativos (Safari / Webkit) */
  video::-webkit-media-controls-volume-slider,
  video::-webkit-media-controls-mute-button {
    display: none !important;
  }

  /* Section Header */
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 8px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 500;
    color: var(--color-primary);
    line-height: 1.2;
    margin-bottom: 12px;
    text-align: center;
  }

  .title-divider {
    width: 48px;
    height: 1px;
    background-color: rgba(35, 8, 4, 0.2);
  }

  /* Columns Grid (Date & Time) */
  .details-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 460px;
    gap: 32px;
  }

  .detail-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    flex: 1;
  }

  .detail-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-secondary);
    letter-spacing: 0.15em;
    line-height: 1.2;
  }

  .detail-value {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .detail-subtext {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-secondary);
  }

  .vertical-divider {
    width: 1px;
    height: 50px;
    background-color: rgba(35, 8, 4, 0.15);
  }

  /* Location info block */
  .location-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    width: 100%;
  }

  .location-value {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .location-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-accent-green);
    text-decoration: none;
    transition: var(--transition-smooth);
    padding: 2px 4px;
    border-radius: var(--border-radius-sm);
  }

  .location-link .material-symbols-outlined {
    font-size: 18px;
    font-variation-settings:
      "FILL" 1,
      "wght" 400,
      "GRAD" 0,
      "opsz" 24;
  }

  .location-link:hover {
    color: var(--color-primary);
    text-shadow: 0 1px 2px rgba(35, 8, 4, 0.05);
  }

  .location-subtext {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-secondary);
  }

  /* Presenters Section & Grid */
  .presenters-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 900px;
    gap: 16px;
    margin-top: 8px;
  }

  .presenter-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-secondary);
    letter-spacing: 0.15em;
    line-height: 1.2;
    text-align: center;
  }

  .presenters-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    width: 100%;
  }

  /* Tarjeta Académica Base */
  .presenter-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background-color: var(--color-surface-container-low, #f4f3f1);
    border: 1px solid rgba(35, 8, 4, 0.04);
    border-radius: var(--border-radius-default, 4px);
    padding: 14px 18px;
    text-align: left;
    box-shadow: 0 2px 6px rgba(35, 8, 4, 0.01);
    position: relative;
    z-index: 1;
    
    /* Estado inicial: invisible y reducido */
    opacity: 0;
    transform: translateY(15px) scale(0.96);
    
    /* Transiciones ultra suaves y calmadas de 0.8s */
    transition: 
      opacity 0.8s cubic-bezier(0.25, 0.8, 0.25, 1),
      transform 0.8s cubic-bezier(0.25, 0.8, 0.25, 1),
      border-color 0.8s ease,
      box-shadow 0.8s ease,
      background-color 0.8s ease;
  }
  
  /* Estado revelado al scroll (Normal) */
  .presenter-card.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  
  /* Efecto Spotlight: Atenuar tarjetas inactivas */
  .presenters-grid.has-highlighted .presenter-card:not(.highlighted) {
    opacity: 0.55;
    transform: scale(0.95) translateY(0);
    box-shadow: none;
    border-color: rgba(35, 8, 4, 0.02);
  }
  
  /* Estado Destacado (Spotlight Activo) */
  .presenter-card.highlighted {
    opacity: 1 !important;
    transform: translateY(-5px) scale(1.08) !important;
    border-color: rgba(74, 103, 65, 0.45) !important;
    background-color: var(--color-surface, #faf9f6) !important;
    box-shadow: 0 8px 24px rgba(35, 8, 4, 0.08) !important;
    z-index: 3;
