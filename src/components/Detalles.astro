  .presenter-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: rgba(74, 103, 65, 0.1); /* Verde orgánico a 10% opacidad */
    color: var(--color-accent-green, #4a6741);
    border-radius: 50%;
    flex-shrink: 0;
