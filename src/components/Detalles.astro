  .presenter-icon .material-symbols-outlined {
    font-size: 16px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  .presenter-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .presenter-title {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    color: var(--color-accent-green, #4a6741); /* Verde orgánico en lugar de dorado o amarillo */
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .presenter-name {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.25;
  }

  /* Ajustes de grilla responsiva */
  @media (max-width: 850px) {
    .presenters-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

