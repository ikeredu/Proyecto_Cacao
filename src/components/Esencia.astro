---
// Esencia component representing the academic details of the cacao project
---

<section id="esencia" class="esencia-section">
  <!-- Section 1: Campos Formativos -->
  <div class="campos-container">
    <div class="section-header">
      <h2 class="section-title">Campos Formativos</h2>
      <div class="title-divider"></div>
    </div>

    <div class="cards-grid">
      <!-- Card 1 -->
      <div class="formativo-card">
        <div class="paper-texture"></div>
        <div class="card-icon-wrapper">
          <span class="material-symbols-outlined">balance</span>
        </div>
        <h3 class="card-heading">Ética, Naturaleza y Sociedad</h3>
        <p class="card-description">
          Exploramos el impacto socio-ambiental y la responsabilidad ética en su cadena de valor.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="formativo-card">
        <div class="paper-texture"></div>
        <div class="card-icon-wrapper">
          <span class="material-symbols-outlined">biotech</span>
        </div>
        <h3 class="card-heading">Saberes y Pensamiento Científico</h3>
        <p class="card-description">
          Análisis químico y botánico del fruto, uniendo ciencia moderna con herencia ancestral.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="formativo-card">
        <div class="paper-texture"></div>
        <div class="card-icon-wrapper">
          <span class="material-symbols-outlined">auto_stories</span>
        </div>
        <h3 class="card-heading">Lenguajes</h3>
        <p class="card-description">
          La narrativa visual y escrita que rodea al cacao como símbolo de identidad cultural.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="formativo-card">
        <div class="paper-texture"></div>
        <div class="card-icon-wrapper">
          <span class="material-symbols-outlined">groups</span>
        </div>
        <h3 class="card-heading">De lo humano a lo comunitario</h3>
        <p class="card-description">
          Fomentamos la identidad comunitaria, la colaboración solidaria y el bienestar compartido a través del cacao como elemento de unión.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Base section - Full Screen height with vertical centering */
  .esencia-section {
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: var(--color-background);
    box-sizing: border-box;
  }

  /* Paper texture pattern for cards */
  .paper-texture {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--color-outline-variant, #d5c2bf) 0.6px, transparent 0.6px);
    background-size: 24px 24px;
    opacity: 0.15;
    pointer-events: none;
    z-index: 1;
  }

  /* Container styling - Flex layout to center content vertically and take full viewport */
  .campos-container {
    width: 100%;
    max-width: var(--spacing-container-max, 1200px);
    margin: 0 auto;
    padding: 96px var(--margin-desktop, 64px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
  }

  .section-header {
    margin-bottom: 48px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 500;
    color: var(--color-primary);
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .title-divider {
    width: 48px;
    height: 1px;
    background-color: rgba(35, 8, 4, 0.2);
  }

  /* Grid and Cards */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
  }

  /* Tarjeta Formativa Base */
  .formativo-card {
    position: relative;
    background-color: var(--color-surface-container-low, #f4f3f1);
    border: 1px solid rgba(35, 8, 4, 0.05);
    border-radius: var(--border-radius-default, 4px);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: hidden;
    box-sizing: border-box;
    
    /* Estado inicial para la entrada escalonada */
    opacity: 0;
    transform: translateY(25px);
    
    /* Transiciones unificadas suaves */
    transition: 
      opacity 0.8s cubic-bezier(0.25, 0.8, 0.25, 1),
      transform 0.8s cubic-bezier(0.25, 0.8, 0.25, 1),
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }
  
  /* Estado visible disparado por scroll */
  .formativo-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  /* Hover en la tarjeta */
  .formativo-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(35, 8, 4, 0.06);
    border-color: rgba(74, 103, 65, 0.2); /* Borde con tinte verde suave */
  }
  
  /* Contenedor del Icono y su Hover */
  .card-icon-wrapper {
    position: relative;
    z-index: 2;
    width: 40px;
    height: 40px;
    background-color: var(--color-primary);
    color: var(--color-background);
    border-radius: var(--border-radius-sm, 2px);
    display: flex;
    align-items: center;
    justify-content: center;
    
    /* Transición para el cambio de fondo a verde */
    transition: background-color 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  .formativo-card:hover .card-icon-wrapper {
    background-color: var(--color-accent-green); /* Pasa a verde en hover */
  }
  
  /* Icono interior y su Hover */
  .card-icon-wrapper .material-symbols-outlined {
    font-size: 20px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    
    /* Transición para el escalado y rotación */
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  .formativo-card:hover .card-icon-wrapper .material-symbols-outlined {
    transform: scale(1.12) rotate(8deg); /* Crece y gira levemente */
  }

  .card-heading {
    position: relative;
    z-index: 2;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--color-primary);
    line-height: 1.3;
  }

  .card-description {
    position: relative;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-on-surface-variant, #514441);
    line-height: 1.6;
  }

  /* Responsive styling */
  @media (max-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .campos-container {
      padding: 64px var(--margin-mobile, 20px) 48px;
    }

    .section-header {
      margin-bottom: 32px;
    }

    .section-title {
      font-size: 26px;
      margin-bottom: 8px;
    }

    .cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .formativo-card {
      padding: 24px;
      gap: 12px;
    }

    .card-heading {
      font-size: 18px;
    }

    .card-description {
      font-size: 13.5px;
      line-height: 1.5;
    }
  }
</style>

<script>
  // Detección de scroll para la entrada escalonada de las tarjetas formativas
  const observerOptions = {
    root: null,
    rootMargin: '50px',
    threshold: 0.1
  };

  const cardsObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const cards = entry.target.querySelectorAll('.formativo-card');
        cards.forEach((card, index) => {
          if (card instanceof HTMLElement) {
            card.style.transitionDelay = `${index * 120}ms`;
            card.classList.add('visible');
          }
        });
        cardsObserver.unobserve(entry.target);
      }
    });
  }, observerOptions);

  const cardsGrid = document.querySelector('.cards-grid');
  if (cardsGrid) {
    cardsObserver.observe(cardsGrid);
  }
</script>
